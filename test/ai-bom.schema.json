{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presencis.com/schemas/ai-bom.schema.json",
  "title": "Presencis AI-BOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model", "alignment"],
  "properties": {
    "schema": { "const": "presencis-ai-bom-v1" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provenance",
        "base_architecture",
        "domain_specialization",
        "precision",
        "evaluation",
        "attestation"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "supplier", "retrieved_at"],
          "properties": {
            "origin": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "supplier": { "type": "string", "minLength": 1, "maxLength": 256 },
            "retrieved_at": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "base_architecture": { "type": "string", "minLength": 1, "maxLength": 128 },
        "domain_specialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "lineage"],
          "properties": {
            "domain": { "type": "string", "minLength": 1, "maxLength": 128 },
            "lineage": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "precision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantization", "profile"],
          "properties": {
            "quantization": { "type": "string", "minLength": 1, "maxLength": 64 },
            "profile": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "enum": ["judged", "cannot-tell", "untested"] },
            "evidence_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "scope": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "observed_at": { "type": "string", "minLength": 1, "maxLength": 64 },
            "method": { "type": "string", "minLength": 1, "maxLength": 256 },
            "limitations": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest_alg", "digest_hex", "signature_alg", "signature_hex", "key_id"],
          "properties": {
            "digest_alg": { "const": "sha-256" },
            "digest_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signature_alg": { "enum": ["ml-dsa-65", "ed25519", "hybrid-ed25519-mldsa65"] },
            "signature_hex": { "type": "string", "pattern": "^[0-9a-f]{64,6618}$" },
            "key_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "alignment": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "enum": ["eu-ai-act-art-11", "iso-42001", "nist-ai-rmf"] }
    }
  }
}
